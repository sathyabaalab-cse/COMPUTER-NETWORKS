#include <stdio.h>

int main()
{
    int n, i;
    int data[100];
    int count = 0;
    int parity;
    FILE *fp;

    printf("Enter number of bits: ");
    scanf("%d", &n);

    printf("Enter data bits:\n");
    for(i = 0; i < n; i++)
    {
        scanf("%d", &data[i]);

        if(data[i] == 1)
            count++;
    }

    // Odd Parity
    if(count % 2 == 0)
        parity = 1;
    else
        parity = 0;

    fp = fopen("data.txt", "w");

    fprintf(fp, "%d\n", n + 1);   // total bits

    for(i = 0; i < n; i++)
        fprintf(fp, "%d ", data[i]);

    fprintf(fp, "%d", parity);

    fclose(fp);

    printf("\nData Sent Successfully.\n");
    printf("Written to data.txt\n");

    return 0;
}









#include <stdio.h>

int main()
{
    int n, i, data[100], count = 0;
    int modifyBits;
    int pos; 
    FILE *fp;
    fp = fopen("data.txt", "r");
    if(fp == NULL)
    {
        printf("Cannot open data.txt\n");
        return 1;
    }
    fscanf(fp, "%d", &n);
    for(i = 0; i < n; i++)
        fscanf(fp, "%d", &data[i]);
    fclose(fp);
    printf("Received Data : ");
    for(i = 0; i < n; i++)
        printf("%d", data[i]);
    printf("\n");
    printf("\nHow many bits do you want to modify (0-%d)? ", n);
    scanf("%d", &modifyBits);
    if(modifyBits < 0 || modifyBits > n)
    {
        printf("Invalid number of bits.\n");
        return 1;
    }
    for(i = 0; i < modifyBits; i++)
    {
        printf("Enter Position %d (1-%d): ", i + 1, n);
        scanf("%d", &pos);

        if(pos >= 1 && pos <= n)
        {
            data[pos - 1] = !data[pos - 1];
        }
        else
        {
            printf("Invalid Position.\n");
            return 1;
        }
    }
    printf("\nModified Data : ");
    for(i = 0; i < n; i++)
        printf("%d", data[i]);
    printf("\n");
   count = 0;
    for(i = 0; i < n; i++)
    {
        if(data[i] == 1)
        {
            count++;
        }
    }
    if(count % 2 == 1)
    {
        printf("\nResult : No Error (Odd Parity Correct)\n");
    }
    else
    {
        printf("\nResult : Error Detected\n");
    }
return 0;
}
