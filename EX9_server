#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>

#define PORT 8080
#define MAX_ENTRIES 100
#define MAC_LEN 18
#define IP_LEN 16
#define BUFFER_SIZE 1024

typedef struct {
    char mac[MAC_LEN];
    char ip[IP_LEN];
} RARP_Entry;

RARP_Entry table[MAX_ENTRIES] = {
    {"00:1A:2B:3C:4D:5E", "192.168.1.10"},
    {"00:AA:BB:CC:DD:EE", "192.168.1.25"}
};
int entry_count = 2;

// Modified to return string responses over the socket
void handle_missing_mac(const char* requested_mac, char* response) {
    char choice;
    char new_ip[IP_LEN];

    printf("\n  [SERVER ALERT] MAC Address [%s] not found in cache table!", requested_mac);
    printf("\nWould you like to manually bind an IP to this MAC address right now? (y/n): ");
    scanf(" %c", &choice);

    if (choice == 'y' || choice == 'Y') {
        if (entry_count >= MAX_ENTRIES) {
            strcpy(response, "ERROR: Server database is completely full.");
            return;
        }
        printf("Enter the IP address to map with %s: ", requested_mac);
        scanf("%s", new_ip);

        strncpy(table[entry_count].mac, requested_mac, MAC_LEN);
        strncpy(table[entry_count].ip, new_ip, IP_LEN);
        entry_count++;

        sprintf(response, "SUCCESS: Dynamically mapped %s to %s", requested_mac, new_ip);
        printf("[SERVER] Added new entry.\n");
    } else {
        strcpy(response, "ERROR: RARP Request Denied - MAC Not Found in Server Cache.");
        printf("[SERVER] Request ignored by admin.\n");
    }
}

int main() {
    int sockfd;
    char buffer[BUFFER_SIZE];
    char reply_message[BUFFER_SIZE];
    struct sockaddr_in server_addr, client_addr;
    socklen_t addr_len = sizeof(client_addr);

    if ((sockfd = socket(AF_INET, SOCK_DGRAM, 0)) < 0) {
        perror("Socket creation failed");
        exit(EXIT_FAILURE);
    }

    memset(&server_addr, 0, sizeof(server_addr));
    server_addr.sin_family = AF_INET;
    server_addr.sin_addr.s_addr = INADDR_ANY;
    server_addr.sin_port = htons(PORT);

    if (bind(sockfd, (const struct sockaddr *)&server_addr, sizeof(server_addr)) < 0) {
        perror("Bind failed");
        exit(EXIT_FAILURE);
    }

    printf("=== RARP Network Server Online (Listening on port %d) ===\n", PORT);

    while (1) {
        memset(buffer, 0, BUFFER_SIZE);
        memset(reply_message, 0, BUFFER_SIZE);

        // Receive packet
        int n = recvfrom(sockfd, buffer, BUFFER_SIZE, 0, (struct sockaddr *)&client_addr, &addr_len);
        buffer[n] = '\0';

        printf("\n[SERVER] Received Request from Client for MAC: %s\n", buffer);

        // Look up mapping logic
        int found = 0;
        int i;
        for (i = 0; i < entry_count; i++) {
            if (strcasecmp(table[i].mac, buffer) == 0) {
                sprintf(reply_message, "SUCCESS: Found IP address -> %s", table[i].ip);
                found = 1;
                break;
            }
        }

        if (!found) {
            handle_missing_mac(buffer, reply_message);
        }

        // Send confirmation back to client
        sendto(sockfd, reply_message, strlen(reply_message) + 1, 0, (struct sockaddr *)&client_addr, addr_len);
    }

    close(sockfd);
    return 0;
}
