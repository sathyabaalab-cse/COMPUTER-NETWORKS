#include <stdio.h>
#include <string.h>

#define MAX 100

int main()
{
    char word[MAX];
    int data[MAX][8];
    int rowParity[MAX];
    int colParity[8];
    int overallParity;
    int rows, i, j, count;

    FILE *fp;

    fp = fopen("message.txt", "r");
    if(fp == NULL)
    {
        printf("Error: Cannot open 'message.txt' file.\n");
        return 1;
    }

    if(fgets(word, sizeof(word), fp) == NULL)
    {
        printf("Error: 'message.txt' file is empty.\n");
        fclose(fp);
        return 1;
    }

    fclose(fp);

    word[strcspn(word,"\n")] = '\0';
    word[strcspn(word,"\r")] = '\0';

    rows = strlen(word);


    for(i=0;i<rows;i++)
    {
        unsigned char ch = word[i];

        for(j=7;j>=0;j--)
        {
            data[i][7-j] = (ch>>j)&1;
        }
    }

    for(i=0;i<rows;i++)
    {
        count = 0;

        for(j=0;j<8;j++)
            count += data[i][j];

        if(count%2==0)
            rowParity[i]=1;
        else
            rowParity[i]=0;
    }

    for(j=0;j<8;j++)
    {
        count = 0;

        for(i=0;i<rows;i++)
            count += data[i][j];

        if(count%2==0)
            colParity[j]=1;
        else
            colParity[j]=0;
    }
    overallParity = 0;

    for(i=0;i<rows;i++)
    {
        for(j=0;j<8;j++)
            overallParity += data[i][j];

        overallParity += rowParity[i];
    }

    for(j=0;j<8;j++)
        overallParity += colParity[j];

    if(overallParity%2==0)
        overallParity=1;
    else
        overallParity=0;

    printf("\n=== 2D ODD PARITY MATRIX ===\n");
    printf("Input word: \"%s\"\n",word);
    printf("Rows: %d   Cols: 8 (bits per char MSB..LSB)\n",rows);
    printf("Parity type: ODD (row, column, overall)\n\n");

    printf("-------------------------------------------------\n");
    printf("| R | Char | b7 b6 b5 b4 b3 b2 b1 b0 | RParity |\n");
    printf("-------------------------------------------------\n");

    for(i=0;i<rows;i++)
    {
        printf("| %d |  %c   | ",i+1,word[i]);

        for(j=0;j<8;j++)
            printf("%d ",data[i][j]);

        printf("|   %d     |\n",rowParity[i]);
    }

    printf("-------------------------------------------------\n");

    printf("|CParity   | ");

    for(j=0;j<8;j++)
        printf("%d ",colParity[j]);

    printf("| OvrP=%d |\n",overallParity);

    printf("-------------------------------------------------\n");

    fp = fopen("parity.txt","w");

    if(fp==NULL)
    {
        printf("Cannot create parity.txt\n");
        return 0;
    }

    fprintf(fp,"%d\n",rows);

    for(i=0;i<rows;i++)
    {
        for(j=0;j<8;j++)
            fprintf(fp,"%d ",data[i][j]);

        fprintf(fp,"%d\n",rowParity[i]);
    }

    for(j=0;j<8;j++)
        fprintf(fp,"%d ",colParity[j]);

    fprintf(fp,"%d\n",overallParity);

    fclose(fp);

    printf("Matrix array trace written successfully into 'parity.txt'\n");

    return 0;
}
#include <stdio.h>
#include <stdlib.h>

#define MAXROWS 100
#define COLS 8

int main()
{
    FILE *fp;

    int rows;
    int data[MAXROWS][COLS];
    int rowParity[MAXROWS];
    int colParity[COLS];
    int overallParity;

    int i,j;
    int count;

    int changes;
    int row,col;

    fp=fopen("parity.txt","r");

    if(fp==NULL)
    {
        printf("Unable to open parity.txt\n");
        return 0;
    }

    fscanf(fp,"%d",&rows);

    for(i=0;i<rows;i++)
    {
        for(j=0;j<COLS;j++)
            fscanf(fp,"%d",&data[i][j]);

        fscanf(fp,"%d",&rowParity[i]);
    }

    for(j=0;j<COLS;j++)
        fscanf(fp,"%d",&colParity[j]);

    fscanf(fp,"%d",&overallParity);

    fclose(fp);

    printf("\n=========== ODD PARITY RECEIVER ===========\n");

    printf("\nReceived Matrix\n\n");

    for(i=0;i<rows;i++)
    {
        for(j=0;j<COLS;j++)
            printf("%d ",data[i][j]);

        printf("| %d",rowParity[i]);
        printf("\n");
    }

    printf("------------------------------------------\n");

    for(j=0;j<COLS;j++)
        printf("%d ",colParity[j]);

    printf("| %d\n",overallParity);

    printf("\nChecking Received Odd Parity...\n\n");
    /**************** ODD PARITY CHECK ****************/

    int parityError = 0;

    /* ---------- ROW CHECK ---------- */

    for(i=0;i<rows;i++)
    {
        count = 0;

        for(j=0;j<COLS;j++)
            count += data[i][j];

        /* Odd parity:
        Data bits + Row parity must be ODD
        */

        if(((count + rowParity[i]) % 2) != 1)
            parityError = 1;
    }

    /* ---------- COLUMN CHECK ---------- */

    for(j=0;j<COLS;j++)
    {
        count = 0;

        for(i=0;i<rows;i++)
            count += data[i][j];

        /* Odd parity:
        Column bits + Column parity must be ODD
        */

        if(((count + colParity[j]) % 2) != 1)
            parityError = 1;
    }

    /* ---------- OVERALL PARITY CHECK ---------- */

    int total = 0;

    for(i=0;i<rows;i++)
    {
        for(j=0;j<COLS;j++)
            total += data[i][j];

        total += rowParity[i];
    }

    for(j=0;j<COLS;j++)
        total += colParity[j];

    /* Overall parity must also be ODD */

    if(((total + overallParity) % 2) != 1)
        parityError = 1;

    /* ---------- DISPLAY RESULT ---------- */

    if(parityError)
    {
        printf("Transmission Error Detected.\n");
    }
    else
    {
        printf("No Error Detected.\n");
    }
    /**************** MODIFY BITS ****************/

    printf("\nHow many bits do you want to change? ");
    scanf("%d",&changes);

    for(i=0;i<changes;i++)
    {
        printf("\nEnter Row (1-%d): ",rows);
        scanf("%d",&row);

        printf("Enter Column (1-8): ");
        scanf("%d",&col);

        if(row>=1 && row<=rows && col>=1 && col<=8)
        {
            /* Flip the selected bit */

            if(data[row-1][col-1]==0)
                data[row-1][col-1]=1;
            else
                data[row-1][col-1]=0;

            printf("Bit at Row %d Column %d flipped successfully.\n",
                    row,col);
        }
        else
        {
            printf("Invalid Position.\n");
            i--;
        }
    }

    /**************** DISPLAY MODIFIED MATRIX ****************/

    printf("\n========== MODIFIED MATRIX ==========\n\n");

    

    for(i=0;i<rows;i++)
    {
        count = 0;

        for(j=0;j<COLS;j++)
        {
            printf("%d ", data[i][j]);   // Print ONLY ONCE
            count += data[i][j];
        }

        /* Calculate new odd row parity */
        int newRowParity = (count % 2 == 0) ? 1 : 0;

        printf("| %d\n", newRowParity);
    }

    printf("------------------------------------------\n");

    /* New column parity */

    int newColParity[COLS];

    for(j=0;j<COLS;j++)
    {
        count = 0;

        for(i=0;i<rows;i++)
            count += data[i][j];

        newColParity[j] = (count % 2 == 0) ? 1 : 0;

        printf("%d ", newColParity[j]);
    }
    int newOverallParity = 0;

    for(i=0;i<rows;i++)
    {
        count = 0;

        for(j=0;j<COLS;j++)
            count += data[i][j];

        newOverallParity ^= ((count % 2 == 0) ? 1 : 0);
    }

    for(j=0;j<COLS;j++)
        newOverallParity ^= newColParity[j];

    printf("| %d\n", newOverallParity);
    printf("| %d\n",overallParity);

    printf("\nChecking Odd Parity After Modification...\n\n");
    /**************** CHECK AFTER MODIFICATION ****************/

    int rowError[MAXROWS];
    int colError[COLS];

    int rowCount = 0;
    int colCount = 0;

    /* -------- ROW CHECK -------- */

    for(i=0;i<rows;i++)
    {
        count = 0;

        for(j=0;j<COLS;j++)
            count += data[i][j];

        /* Odd parity */
        if(((count + rowParity[i]) % 2) != 1)
        {
            rowError[rowCount++] = i + 1;
        }
    }

    /* -------- COLUMN CHECK -------- */

    for(j=0;j<COLS;j++)
    {
        count = 0;

        for(i=0;i<rows;i++)
            count += data[i][j];

        /* Odd parity */
        if(((count + colParity[j]) % 2) != 1)
        {
            colError[colCount++] = j + 1;
        }
    }

    /* -------- OVERALL PARITY CHECK -------- */
    int overallError = 0;

    for(i=0;i<rows;i++)
    {
        for(j=0;j<COLS;j++)
            total += data[i][j];

        total += rowParity[i];
    }

    for(j=0;j<COLS;j++)
        total += colParity[j];

    if(((total + overallParity) % 2) != 1)
        overallError = 1;

    /* -------- DISPLAY -------- */

    printf("Affected Rows : ");

    if(rowCount==0)
        printf("None");
    else
    {
        for(i=0;i<rowCount;i++)
            printf("%d ",rowError[i]);
    }

    printf("\nAffected Columns : ");

    if(colCount==0)
        printf("None");
    else
    {
        for(i=0;i<colCount;i++)
            printf("%d ",colError[i]);
    }

    printf("\nOverall Parity : ");

    if(overallError)
        printf("Mismatch\n");
    else
        printf("Correct\n");

    /**************** CASE DETECTION ****************/

    if(rowCount==0 && colCount==0 && overallError==0)
    {
        printf("\n=========================================\n");
        printf("Case 4 : Four Errors Cannot Be Detected\n");
        printf("=========================================\n");

        printf("No parity mismatch found.\n");
        printf("Either:\n");
        printf("1. No transmission error.\n");
        printf("2. Four-bit rectangular error (cannot be detected).\n");
    }

    else if(rowCount==1 && colCount==1)
    {
        printf("\n=========================================\n");
        printf("Case 1 : One Error Affects Two Parities\n");
        printf("=========================================\n");

        printf("Single Bit Error Detected.\n");
        printf("Error Location : Row %d Column %d\n",
                rowError[0],colError[0]);
    }

    else if(rowCount==2 && colCount==2)
    {
        printf("\n=========================================\n");
        printf("Case 2 : Two Errors Affect Two Parities\n");
        printf("=========================================\n");

        printf("Two Bit Errors Detected.\n");
    }

    else if(rowCount>=2 || colCount>=2)
    {
        printf("\n=========================================\n");
        printf("Case 3 : Three Errors Affect Four Parities\n");
        printf("=========================================\n");

        printf("Multiple Bit Errors Detected.\n");
    }

    else
    {
        printf("\nParity mismatch detected.\n");
    }

    /**************** FINAL RESULT ****************/

    printf("\n=========================================\n");

    if(rowCount==0 && colCount==0 && overallError==0)
        printf("FINAL RESULT : DATA ACCEPTED\n");
    else
        printf("FINAL RESULT : TRANSMISSION ERROR DETECTED\n");

   

    return 0;
    }
