            printf(" D%-2d |", dataCount);
            dataCount++;
        }
    }
    printf("\n|------------|");
    for(i = 1; i <= total_len; i++) printf("-----|");
    printf("\n| Value      |");
    for(i = 1; i <= total_len; i++) printf("  %d  |", ham[i]);
    printf("\n");
}

void hammingReceiver(int ham[], int total_len, int r) {
    int i, k, syndrome = 0, first_bit = 1;
    printf("\n--- PERFORMING XOR ON BIT POSITIONS WITH '1' ---\n");

    for (i = 1; i <= total_len; i++) {
        if (ham[i] == 1) {
            if (first_bit) {
                syndrome = i;
                printf("Bit %2d -> Initial Stream: ", i);
                printDynamicBinary(syndrome, r);
                printf(" (Decimal: %d)\n", syndrome);
                first_bit = 0;
            } else {
                printf("Bit %2d -> XOR ", i);
                printDynamicBinary(i, r);
                syndrome ^= i;
                printf(" = New Stream: ");
                printDynamicBinary(syndrome, r);
                printf(" (Decimal: %d)\n", syndrome);
            }
        }
    }
    printf("--------------------------------------------------\n");
    printf("FINAL RESULT:\nBinary Stream (Syndrome) : ");
    printDynamicBinary(syndrome, r);
    printf("\n\n");

    if (syndrome != 0 && syndrome <= total_len) {
        printf("Syndrome != 0 -> Display: Error Detected!\n");
        printf("Decimal Value of Erroneous Bit Position: %d\n\n", syndrome);
        ham[syndrome] = (ham[syndrome] == 1) ? 0 : 1;
        printf("Display: \"Error Corrected\"\n\n");
        
        printf("========================================================================================\n");
        printf("                             CORRECTED HAMMING CODE TABLE STRUCTURE                     \n");
        printf("========================================================================================\n");
        printHorizontalTable(ham, total_len);
        printf("========================================================================================\n\n");
    } else if (syndrome > total_len) {
        printf("Syndrome calculation out of bounds (%d). Multiple transmission errors likely.\n", syndrome);
    } else {
        printf("Syndrome == 0 -> Display: Code Clean (No Error Detected)!\n\n");
    }

    printf("Displaying Original Data: ");
    k = 1;
    for (i = 1; i <= total_len; i++) {
        if (i == (int)pow(2, k - 1)) k++;
        else printf("%d", ham[i]);
    }
    printf("\n");
}

int main() {
    FILE *fp = fopen("sender.txt", "r");
    if (!fp) {
        printf("Error: Cannot open sender.txt\n");
        return 1;
    }
    char received_str[100] = {0};
    fscanf(fp, "%s", received_str);
    fclose(fp);

    int total_len = strlen(received_str);
    int ham[100];
    int i, r;
    
    for (i = 1; i <= total_len; i++) ham[i] = received_str[i - 1] - '0';

    printf("Received code from file: %s\n", received_str);
    
    // Automatically find 'r' matching length to avoid mismatches
    r = 0;
    while ((total_len - r) + r != total_len || pow(2, r) < total_len + 1) r++;
    printf("Detected Parity Bits Implied (r): %d\n", r);

    int choice, error_pos = 0;
    printf("Do you want to inject a transmission error? (1 = Yes, 0 = No): ");
    if (scanf("%d", &choice) != 1) return 1;

    if (choice == 1) {
        printf("Enter bit position to corrupt/flip (1 to %d): ", total_len);
        if (scanf("%d", &error_pos) != 1) return 1;

        if (error_pos >= 1 && error_pos <= total_len) {
            ham[error_pos] = (ham[error_pos] == 1) ? 0 : 1;
            printf("\n========================================================================================\n");
            printf("                             CORRUPTED RECEIVED CODE STRUCTURE                          \n");
            printf("========================================================================================\n");
            printHorizontalTable(ham, total_len);
            printf("========================================================================================\n");
        }
    }

    hammingReceiver(ham, total_len, r);
    return 0;
}
