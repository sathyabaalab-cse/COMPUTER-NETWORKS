#include <stdio.h>
#include <math.h>
#include <string.h>
#include <stdlib.h>

void printHorizontalTable(int ham[], int total_len) {
    int i, k;
    printf("| Position   |");
    for(i = 1; i <= total_len; i++) printf(" %2d  |", i);
    printf("\n|------------|");
    for(i = 1; i <= total_len; i++) printf("-----|");
    printf("\n| Bit Type   |");
    k = 1; int dataCount = 1;
    for(i = 1; i <= total_len; i++) {
        if(i == (int)pow(2, k - 1)) {
            printf(" P%-2d |", (int)pow(2, k - 1));
            k++;
        } else {
            printf(" D%-2d |", dataCount);
            dataCount++;
        }
    }
    printf("\n|------------|");
    for(i = 1; i <= total_len; i++) printf("-----|");
    printf("\n| Value      |");
    for(i = 1; i <= total_len; i++) {
        if(ham[i] == -1) printf("  P  |");
        else printf("  %d  |", ham[i]);
    }
    printf("\n");
}

void generateHamming(int data[], int ham[], int m, int *n, int r) {
    int i, j, k = 1, p, count;
    *n = m + r;

    int temp_m = m;
    for(i = 1; i <= *n; i++) {
        if(i == (int)pow(2, k - 1)) {
            ham[i] = -1; 
            k++;
        } else {
            ham[i] = data[temp_m];
            temp_m--;
        }
    }

    printf("========================================================================================\n");
    printf("                        HAMMING CODE STRUCTURE (BEFORE PARITY BITS)                     \n");
    printf("========================================================================================\n");
    printHorizontalTable(ham, *n);
    printf("========================================================================================\n\n");

    printf("--- PARITY BIT XOR CALCULATIONS ---\n");
    for(i = 0; i < r; i++) {
        p = (int)pow(2, i);
        count = 0;
        printf("P%d at Pos %d -> XOR of bits at positions: ", p, p);
        for(j = 1; j <= *n; j++) {
            if((j & p) && (j != p)) {
                printf("%d ", j);
                if(ham[j] != -1) count += ham[j];
            }
        }
        ham[p] = count % 2;
        printf("| Result parity bit = %d\n", ham[p]);
    }
}

int main() {
    int data[30], ham[60];
    int m = 16, n, r = 0, i;
    FILE *fp;
    char content[50] = {0};

    fp = fopen("message.txt", "r");
    if (fp == NULL) {
        printf("Error: message.txt file not found!\n");
        return 1;
    }
    fgets(content, sizeof(content), fp);
    fclose(fp);
    content[strcspn(content, "\n")] = 0;

    printf("==========================================\n");
    printf("       MESSAGE INSIDE message.txt\n");
    printf("==========================================\n");
    printf("Text Content: %s\n", content);
    printf("==========================================\n\n");

    int bIdx = 1; 
    for (i = 0; i < 2 && content[i] != '\0'; i++) {
        unsigned char ch = content[i];
        for (int j = 7; j >= 0; j--) {
            data[bIdx++] = ((ch >> j) & 1);
        }
    }
    while (bIdx <= 16) data[bIdx++] = 0;

    printf("Input Binary (m = 16 bits): ");
    for(i = 1; i <= m; i++) printf("%d", data[i]);
    printf("\n\n");

    // Automatically calculate valid r value to prevent -1 and -3 bugs
    while(pow(2, r) < m + r + 1) {
        r++;
    }
    printf("Calculated Parity Bits Required (r) = %d\n\n", r);

    generateHamming(data, ham, m, &n, r);

    printf("\n========================================================================================\n");
    printf("                        FINAL HAMMING CODE STRUCTURE (AFTER PARITY BITS)                \n");
    printf("========================================================================================\n");
    printHorizontalTable(ham, n);
    printf("========================================================================================\n\n");

    printf("Final Hamming Code Stream: ");
    for(i = 1; i <= n; i++) printf("%d", ham[i]);
    printf("\n\n");

    fp = fopen("sender.txt", "w");
    for(i = 1; i <= n; i++) fprintf(fp, "%d", ham[i]);
    fclose(fp);
    printf("Written to 'sender.txt' successfully.\n");

    return 0;
}
