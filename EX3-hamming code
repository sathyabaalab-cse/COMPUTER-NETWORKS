void printDynamicBinary(int num, int r) {
    for (int i = r - 1; i >= 0; i--) printf("%d", (num >> i) & 1);
}

void printHorizontalTable(int ham[], int total_len) {
    int i, k;
    printf("| Position   |");
    for(i = 1; i <= total_len; i++) printf(" %2d  |", i);
    printf("\n|------------|");
