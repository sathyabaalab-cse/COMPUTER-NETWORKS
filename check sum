#include <stdio.h>
#include <string.h>
void bitDestuff(char input[], char output[]);
void print8Bits(char data[]);


void addBinary(char a[], char b[], char result[])
{
    int i;
    int carry = 0;
    int sum;

    for(i=7;i>=0;i--)
    {
        sum = (a[i]-'0') + (b[i]-'0') + carry;

        result[i] = (sum % 2) + '0';
        carry = sum / 2;
    }

    while(carry)
    {
        carry = 0;

        for(i=7;i>=0;i--)
        {
            if(result[i]=='0')
            {
                result[i]='1';
                break;
            }
            else
            {
                result[i]='0';

                if(i==0)
                    carry=1;
            }
        }
    }

    result[8]='\0';
}

int verifyChecksum(char frame[])
{
    char sum[9]="00000000";
    char byte[9];
    char final[9];
    int i,j;

    printf("\nCHECKSUM VERIFICATION\n");

    int len = strlen(frame);

    for(i = 0; i + 7 < len; i += 8)
    {
        strncpy(byte, &frame[i], 8);
        byte[8] = '\0';
        printf("\nCurrent Sum : %s",sum);
        printf("\nNext Byte   : %s",byte);

        addBinary(sum,byte,final);

        strcpy(sum,final);

        printf("\nAfter Add   : %s\n",sum);
    }

    printf("\nVerification Result : %s\n",sum);

    for(i=0;i<8;i++)
    {
        if(sum[i]!='1')
            return 0;
    }

    return 1;
}
void bitDestuff(char input[], char output[])
{
    int i=0, j = 0;
    int count = 0;

    while(input[i] != '\0')
    {
        output[j++] = input[i];

        if(input[i] == '1')
        {
            count++;
        if(count == 5)
        {
            if(input[i+1] == '0')
            {
                printf("\n--------------------------------");
                printf("\nBit Destuffing Performed");
                printf("\nFive Consecutive 1's Found");
                printf("\nStuffed Bit Removed : 0");
                printf("\nBit Position : %d", i + 2);
                printf("\n--------------------------------");

                i++;   // Skip only stuffed 0
            }

            count = 0;
        }
        }
        else
        {
            count = 0;
        }

        i++;
    }

    output[j] = '\0';
}
void byteDestuff(char input[], char output[])
{
    int i=0, j = 0;

    while(input[i] != '\0')
    {
        if(strncmp(&input[i], "0111110101111110", 16) == 0)
        {
            printf("\n--------------------------------");
            printf("\nByte Destuffing Performed");
            printf("\nEscape Byte Removed");
            printf("\nRecovered : 01111110");
            printf("\n--------------------------------");

            memcpy(&output[j], "01111110", 8);
            j += 8;
            i += 16;
        }
        else if(strncmp(&input[i], "0111110101111101", 16) == 0)
        {
            printf("\n--------------------------------");
            printf("\nByte Destuffing Performed");
            printf("\nEscape Byte Removed");
            printf("\nRecovered : 01111101");
            printf("\n--------------------------------");

            memcpy(&output[j], "01111101", 8);
            j += 8;
            i += 16;
        }
        else
        {
            memcpy(&output[j], &input[i], 8);
            j += 8;
            i += 8;
        }
    }

    output[j] = '\0';
}
void modifyBit(char frame[])
{
    int pos;

    printf("\nEnter Bit Position (0-%d) : ",(int)strlen(frame)-1);
    scanf("%d",&pos);

    if(pos>=0 && pos<strlen(frame))
    {
        if(frame[pos]=='0')
            frame[pos]='1';
        else
            frame[pos]='0';

        printf("\nBit Modified Successfully.\n");
    }
    else
    {
        printf("\nInvalid Bit Position.\n");
    }
}
void print8Bits(char data[])
{
    int i;

    for(i=0; data[i]!='\0'; i++)
    {
        printf("%c",data[i]);

        if((i+1)%8==0)
            printf(" ");
    }

    printf("\n");
}

int main()
{
    char frame[1000];
    char choice;
    char type[10];
    char noFlagFrame[1000];
    char destuffedFrame[1000];
    FILE *fp=fopen("frame.txt","r");

    if(fp==NULL)
    {
        printf("file not found.\n");
        return 0;
    }
    fscanf(fp,"%s",type);

    printf("\nTransmission Type : %s\n",type);

    printf("\n========== RECEIVER ==========\n");

    char line[1000];

    while(fgets(line, sizeof(line), fp) != NULL)
    {
        /* Skip "Frame x" lines and blank lines */
        if(strncmp(line, "Frame", 5) == 0 || line[0] == '\n')
            continue;

        line[strcspn(line, "\n")] = '\0';

        strcpy(frame, line);

        int len = strlen(frame);

        strncpy(noFlagFrame, frame + 8, len - 16);
        noFlagFrame[len - 16] = '\0';
        printf("\nReceived Frame\n");
        print8Bits(noFlagFrame);

        printf("\nDo you want to modify any bit? (Y/N) : ");
        scanf(" %c", &choice);

        if(choice=='Y' || choice=='y')
        {
            modifyBit(noFlagFrame);

            printf("\nModified Frame\n");
            print8Bits(noFlagFrame);
        }

        if(strcmp(type,"BIT")==0)
        {
            printf("\nBIT RECEIVER\n");


            printf("\nPPP Flag Removed\n");
            printf("%s\n", noFlagFrame);


            printf("\nBefore Destuff\n");
            printf("%s\n", noFlagFrame);


            bitDestuff(noFlagFrame, destuffedFrame);


            printf("\nAfter Destuff\n");
            printf("%s\n", destuffedFrame);
            printf("\nNo Flag Length = %d\n", strlen(noFlagFrame));
            printf("\nDestuffed Length = %d\n", strlen(destuffedFrame));
            printf("\nBit Destuffed Frame\n");
            print8Bits(destuffedFrame);
            int len = strlen(destuffedFrame);

            if(len < 8)
            {
                printf("\nInvalid Frame Length\n");
                continue;
            }

            /* Verify BEFORE removing checksum */

            char verifyFrame[1000];
            strcpy(verifyFrame, destuffedFrame);

            if(verifyChecksum(verifyFrame))
            {
                printf("\nBIT CHECKSUM OK\n");
                printf("Frame Accepted\n");
            }
            else
            {
                printf("\nBIT CHECKSUM ERROR\n");
                printf("Frame Rejected\n");
            }

            /* Now extract checksum */

            char receivedChecksum[9];

            strncpy(receivedChecksum,
                    destuffedFrame + len - 8,
                    8);

            receivedChecksum[8] = '\0';

            destuffedFrame[len - 8] = '\0';

            printf("\nData without checksum\n");
            print8Bits(destuffedFrame);

            printf("\nReceived Checksum : %s\n",
                receivedChecksum);
        }


            


        else if(strcmp(type,"BYTE")==0)
        {
            printf("\nBYTE RECEIVER\n");

            byteDestuff(noFlagFrame, destuffedFrame);

            if(verifyChecksum(destuffedFrame))
            {
                printf("\nBYTE CHECKSUM OK\n");
                printf("Frame Accepted\n");
            }
            else
            {
                printf("\nBYTE CHECKSUM ERROR\n");
                printf("Frame Rejected\n");
            }
        }
    }

    fclose(fp);

    return 0;
}
