void print8Bits(char binary[])
{
    int i = 0;

    while(binary[i] != '\0')
    {
        printf("%c", binary[i]);

        if((i + 1) % 8 == 0 && binary[i + 1] != '\0')
        {
            printf(" ");
        }

        i++;
    }

    printf("\n");
}
void decimalToBinary(int number, int bits, char binary[])
{
    int i;
    binary[bits] = '\0';
    for(i = bits - 1; i >= 0; i--)
    {
        binary[i] = (number % 2) + '0';
        number = number / 2;
    }
}
void characterToBinary(char ch, char binary[])
{
    decimalToBinary((unsigned char)ch, 8, binary);
}
