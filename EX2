void addBinary(char a[], char b[], char result[])
{
    int i;
    int carry = 0;
    int sum;

    for(i = 7; i >= 0; i--)
    {
        sum = (a[i]-'0') + (b[i]-'0') + carry;

        result[i] = (sum % 2) + '0';
        carry = sum / 2;
    }

    /* End-around Carry */
    while(carry)
    {
        carry = 0;

        for(i = 7; i >= 0; i--)
        {
            if(result[i] == '0')
            {
                result[i] = '1';
                break;
            }
            else
            {
                result[i] = '0';

                if(i == 0)
                    carry = 1;
            }
        }
    }

    result[8] = '\0';
}
void calculateChecksum(char frame[], char trailer[])
{
    int i, j;
    char sum[9] = "00000000";
    char byte[9];
    char final[9];   // <-- add this

    printf("\nCHECKSUM CALCULATION\n");

    int len = strlen(frame);

    for(i = 0; i + 7 < len; i += 8)
    {
        strncpy(byte, &frame[i], 8);
        byte[8] = '\0';

        printf("\nCurrent Sum : %s", sum);
        printf("\nNext Byte   : %s", byte);

        addBinary(sum, byte, final);   // <-- use final
        strcpy(sum, final);            // <-- copy back

        printf("\nAfter Add   : %s\n", sum);
    }

    printf("\nOne's Complement\n");

    for(j = 0; j < 8; j++)
    {
        trailer[j] = (sum[j] == '0') ? '1' : '0';
    }

    trailer[8] = '\0';

    printf("Checksum : %s\n", trailer);
}
